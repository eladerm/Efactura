rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files by default
    match /{allPaths=**} {
      allow read;
    }

    // Restrict write access to authenticated users
    match /certs/{fileName} {
      allow write: if request.auth != null && request.resource.contentType == 'application/x-pkcs12';
    }

     // Restrict write access to authenticated users for general uploads
    match /uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
